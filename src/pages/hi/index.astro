---
/*
 * Where the QR on my card lands (HTTPS://LUCASFLATWHITE.COM/HI, sent here by vercel.json).
 * It is the homepage board itself, under a short intro (CardIntro.astro) that unfolds my card
 * into it, so whoever scans ends up on the real thing. The intro comes first in the page so
 * it covers the board before the board is parsed. Only a QR leads here, so search keeps to
 * the homepage.
 */
import CardIntro from '../../components/CardIntro.astro';
import HomeBoard from '../../components/HomeBoard.astro';
import { siteProfile } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={siteProfile.name}
  description={siteProfile.description}
  bodyClass="landing"
  themeColor="#fafafa"
  canonicalPath={withBase()}
  noindex
>
  <CardIntro />
  <HomeBoard />
</BaseLayout>
