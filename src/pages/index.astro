---
import { getCollection } from 'astro:content';
import ArcadeHandheld from '../components/ArcadeHandheld.astro';
import BoardPhotos from '../components/BoardPhotos.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CopyMark from '../components/CopyMark.astro';
import CopyRoll from '../components/CopyRoll.astro';
import DailyShotReceipt from '../components/DailyShotReceipt.astro';
import Glyph from '../components/Glyph.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dailyShot } from '../data/daily-shot';
import { featuredLinks } from '../data/links';
import { siteProfile } from '../data/site';
import { deckOrder } from '../lib/photos';
import {
  arrangeBoard,
  NAME_ROWS,
  PHOTO_ROWS,
  placeProjects,
  stackBoard,
} from '../lib/projects';
import { withBase } from '../lib/paths';
import '../styles/landing.css';

const placed = placeProjects(await getCollection('projects'));
const photos = deckOrder(await getCollection('photos'));
// The book, every pictured project, Daily Shot and the arcade, with pinned projects in their
// numbered slots and gaps after them (src/lib/projects.ts).
const slots = arrangeBoard(placed.board);
const count = slots.length;
const photoRows = photos.length > 0 ? PHOTO_ROWS : 0;
// The board runs three columns on a mid screen and four on a wide one; the spans match.
const three = stackBoard(count, 3, NAME_ROWS, photoRows);
const four = stackBoard(count, 4, NAME_ROWS, photoRows);
const place = (index: number) =>
  [
    `--c3: ${three[index].column}; --r3: ${three[index].row}`,
    `--c4: ${four[index].column}; --r4: ${four[index].row}`,
    `--span: ${four[index].span}`,
  ].join('; ');
const arcadeHref = withBase('arcade/');
const year = new Date().getFullYear();
---

<BaseLayout
  title={siteProfile.name}
  description={siteProfile.description}
  bodyClass="landing"
  themeColor="#fafafa"
>
  <SiteHeader href="#top" />
  <main id="top">
    <section class="board">
      <div class="board-grid">
        <div class="board-copy" style={`--span: ${NAME_ROWS}`}>
          <h1 id="name" class="name" data-name aria-label={siteProfile.name}>
            {['Lucas', 'Flatwhite'].map((word) => (
              <span class="name-line" aria-hidden="true">
                {word.split('').map((letter) => (
                  <span data-name-letter><span class="name-letter-face">{letter}</span></span>
                ))}
              </span>
            ))}
          </h1>
          <p class="name-ko" lang="ko">{siteProfile.nameKo}</p>
          <p class="intro">{siteProfile.intro}</p>
          <ul class="name-links">
            {featuredLinks.map((link) => (
              <li>
                {link.copy !== null ? (
                  <a class="glyph-host" href={link.href} data-copy={link.copy}>
                    <CopyMark icon={link.icon} motion={link.motion} />
                    <CopyRoll text={link.label} />
                  </a>
                ) : (
                  <a class="glyph-host" href={link.href} target="_blank" rel="noreferrer me">
                    <Glyph icon={link.icon} motion={link.motion} />
                    {link.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
        {photoRows > 0 && <BoardPhotos photos={photos} rows={photoRows} />}
        <ol class="board-cards" id="work">
          {slots.map((slot, index) =>
            slot.kind === 'book' ? (
              <li class="board-gap" style={place(index)} aria-hidden="true">
                <span class="gap-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="gap-note">A book on the way</span>
              </li>
            ) : slot.kind === 'project' ? (
              <ProjectCard
                title={slot.entry.data.title}
                summary={slot.entry.data.summary}
                href={slot.entry.data.href}
                repo={slot.entry.data.repo}
                art={slot.entry.data.art!}
                motion={slot.entry.data.motion}
                place={place(index)}
              />
            ) : slot.kind === 'daily' ? (
              <li class="project-card receipt-card" style={place(index)} data-daily-shot>
                <div class="project-art receipt-art">
                  <DailyShotReceipt />
                </div>
                <span class="project-label" aria-hidden="true">{dailyShot.title}</span>
                <div class="project-text">
                  <h3 class="project-title">
                    <a href={dailyShot.href} target="_blank" rel="noreferrer me">
                      {dailyShot.title}
                      <Glyph icon="arrow-up-right" class="project-out" />
                    </a>
                  </h3>
                  <p class="project-summary">{dailyShot.summary}</p>
                </div>
              </li>
            ) : slot.kind === 'arcade' ? (
              <li class="project-card arcade-card" style={place(index)}>
                <div class="project-art arcade-art">
                  <ArcadeHandheld />
                </div>
                <span class="project-label" aria-hidden="true">Flatwhite Arcade</span>
                <div class="project-text">
                  <h3 class="project-title">
                    <a href={arcadeHref}>Flatwhite Arcade</a>
                  </h3>
                  <p class="project-summary">Small games, one cartridge at a time.</p>
                </div>
              </li>
            ) : (
              <li class="board-gap" style={place(index)} aria-hidden="true">
                <span class="gap-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="gap-note">{slot.note}</span>
              </li>
            ),
          )}
        </ol>
      </div>
    </section>
  </main>

  <footer class="colophon">
    <div class="colophon-meta">
      <p class="colophon-shortcut">Press <kbd data-palette-key>Ctrl K</kbd> to jump anywhere.</p>
      <p>&copy; {year} {siteProfile.name}</p>
    </div>
  </footer>
  <CommandPalette />
</BaseLayout>

<script>
  import { mountCopyLinks } from '../lib/copy-link';
  import { bindDailyShot } from '../lib/daily-shot';
  import { bindNameSwap } from '../lib/name-swap';
  import { bindPhotoDeck } from '../lib/photo-deck';
  import { mountSnakePreview } from '../lib/snake-preview';
  import { bindWorkMotion } from '../lib/work-motion';

  const name = document.querySelector<HTMLElement>('[data-name]');
  const preview = document.querySelector<HTMLCanvasElement>('[data-snake-preview]');
  const deck = document.querySelector<HTMLElement>('[data-photo-deck]');
  const receipt = document.querySelector<HTMLElement>('[data-daily-shot]');

  if (name) {
    bindNameSwap(name);
  }

  if (preview) {
    mountSnakePreview(preview);
  }

  if (deck) {
    bindPhotoDeck(deck);
  }

  if (receipt) {
    bindDailyShot(receipt);
  }

  bindWorkMotion(document.querySelectorAll<HTMLElement>('.project-motion'));

  mountCopyLinks();
</script>
