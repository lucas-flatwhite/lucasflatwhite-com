---
import { getCollection } from 'astro:content';
import CommandPalette from '../components/CommandPalette.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CopyMark from '../components/CopyMark.astro';
import CopyRoll from '../components/CopyRoll.astro';
import Glyph from '../components/Glyph.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import timelineSvg from '../assets/work/ai-timeline-log.svg?raw';
import portraitSvg from '../assets/work/lucasflatwhite-com.svg?raw';
import { featuredLinks } from '../data/links';
import { siteProfile } from '../data/site';
import { pictureForId } from '../lib/project-picture';
import { placeProjects } from '../lib/projects';
import { withBase } from '../lib/paths';
import '../styles/landing.css';

const placed = placeProjects(await getCollection('projects'));
const pictured = [...placed.lead, ...placed.rest];
const feature = pictured[0];
const wide = pictured[1];
const rest = pictured.slice(2);
const playHref = withBase('play/');
const year = new Date().getFullYear();
const rawById: Record<string, string> = {
  'ai-timeline-log': timelineSvg,
  'lucasflatwhite-com': portraitSvg,
};
---

<BaseLayout
  title={siteProfile.name}
  description={siteProfile.description}
  bodyClass="landing"
  themeColor="#fafafa"
>
  <SiteHeader href="#top" />
  <main id="top">
    <div class="boxes" id="work" data-projects={Math.min(pictured.length, 2)}>
      <section class="tile tile-name">
        <h1 id="name" class="name">
          <span class="name-line">Lucas</span>
          <span class="name-line">Flatwhite</span>
        </h1>
      </section>
      <section class="tile tile-intro">
        <p class="name-ko" lang="ko">{siteProfile.nameKo}</p>
        <p class="intro">{siteProfile.intro}</p>
      </section>
      {feature && (
        <ProjectCard
          slot="feature"
          title={feature.data.title}
          summary={feature.data.summary}
          tags={feature.data.tags}
          href={feature.data.href}
          repo={feature.data.repo}
          art={feature.data.art!}
          motion={feature.data.motion}
          svg={feature.data.motion ? pictureForId(rawById, feature.id) : undefined}
        />
      )}
      {wide && (
        <ProjectCard
          slot="wide"
          title={wide.data.title}
          summary={wide.data.summary}
          tags={wide.data.tags}
          href={wide.data.href}
          repo={wide.data.repo}
          art={wide.data.art!}
          motion={wide.data.motion}
          svg={wide.data.motion ? pictureForId(rawById, wide.id) : undefined}
        />
      )}
      <a class="tile snake-box" href={playHref} aria-label="Play Snake, in a field of words">
        <canvas data-snake-preview width="160" height="96" aria-hidden="true"></canvas>
        <span>Snake</span>
      </a>
      {featuredLinks.map((link, index) => (
        link.copy !== null ? (
          <a class:list={['tile', 'link-box', 'glyph-host', `link-${index}`]} href={link.href} data-copy={link.copy}>
            <CopyMark icon={link.icon} motion={link.motion} />
            <CopyRoll text={link.label} />
            <span class="link-blurb">{link.blurb}</span>
          </a>
        ) : (
          <a class:list={['tile', 'link-box', 'glyph-host', `link-${index}`]} href={link.href} target="_blank" rel="noreferrer me">
            <Glyph icon={link.icon} motion={link.motion} />
            <span class="link-label">{link.label}</span>
            <span class="link-blurb">{link.blurb}</span>
          </a>
        )
      ))}
    </div>

    {rest.length > 0 && (
      <div class="boxes-rest">
        {rest.map((entry) => (
          <ProjectCard
            title={entry.data.title}
            summary={entry.data.summary}
            tags={entry.data.tags}
            href={entry.data.href}
            repo={entry.data.repo}
            art={entry.data.art!}
            motion={entry.data.motion}
            svg={entry.data.motion ? pictureForId(rawById, entry.id) : undefined}
          />
        ))}
      </div>
    )}
  </main>

  <footer class="colophon">
    <div class="colophon-meta">
      <p>Set in Anybody and Noto Sans KR.</p>
      <p class="colophon-shortcut">Press <kbd data-palette-key>Ctrl K</kbd> to jump anywhere.</p>
      <p>&copy; {year} {siteProfile.name}</p>
    </div>
  </footer>
  <CommandPalette />
</BaseLayout>

<script>
  import { mountCopyLinks } from '../lib/copy-link';
  import { mountSnakePreview } from '../lib/snake-preview';

  const preview = document.querySelector<HTMLCanvasElement>('[data-snake-preview]');

  if (preview) {
    mountSnakePreview(preview);
  }

  mountCopyLinks();
</script>
