---
import Monitor from '../assets/work/terrarium.svg';
type Props = { alt: string };
const { alt } = Astro.props;
---

<div class="project-motion monitor" role="img" aria-label={alt}>
  <Monitor aria-hidden="true" />
</div>

<style>
  /* The illustration itself is the still. The board starts its clock on first sight. */
  @media (prefers-reduced-motion: no-preference) {
    .monitor[data-motion] :global(.terr-claude) {
      animation: claude-session 8s ease infinite;
    }

    .monitor[data-motion] :global(.terr-codex) {
      animation: codex-session 8s ease infinite;
    }

    .monitor[data-motion] :global(.terr-output) {
      animation: print-result 4s steps(1, end) infinite;
    }

    .monitor[data-motion='paused'] :global(.terr-claude),
    .monitor[data-motion='paused'] :global(.terr-codex),
    .monitor[data-motion='paused'] :global(.terr-output) {
      animation-play-state: paused;
    }

    @keyframes claude-session {
      0%, 44%, 100% { opacity: 1; }
      49%, 95% { opacity: 0; }
    }

    @keyframes codex-session {
      0%, 49%, 100% { opacity: 0; }
      54%, 95% { opacity: 1; }
    }

    @keyframes print-result {
      0% { opacity: 0; }
      28%, 100% { opacity: 1; }
    }
  }
</style>
