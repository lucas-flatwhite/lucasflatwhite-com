---
import Glyph from './Glyph.astro';
import { cropPicture } from '../lib/project-picture';

type Art = {
  image: { src: string; width: number; height: number };
  alt: string;
};

type Props = {
  title: string;
  summary: string;
  href: string;
  repo?: string;
  art: Art;
  motion?: 'ripple' | 'years';
  svg?: string;
  place: string;
};

const { title, summary, href, repo, art, motion, svg: picture, place } = Astro.props;
const ready = picture !== undefined && motion !== undefined && picture.includes(`id="${motion}"`);
const svg = ready ? cropPicture(picture) : picture;
---

<li class="project-card" style={place}>
  <div class="project-art">
    {ready ? <div class="project-motion" set:html={svg} role="img" aria-label={art.alt} /> : (
      <img
        src={art.image.src}
        width={art.image.width}
        height={art.image.height}
        alt={art.alt}
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  <span class="project-label" aria-hidden="true">{title}</span>
  <div class="project-text">
    <h3 class="project-title">
      <a href={href} target="_blank" rel="noreferrer">
        {title.split('.').map((part, index) => (index === 0 ? part : <><wbr />.{part}</>))}
        <Glyph icon="arrow-up-right" class="project-out" />
      </a>
    </h3>
    <p class="project-summary">{summary}</p>
  </div>
  {repo && (
    <a class="project-source glyph-host" href={repo} target="_blank" rel="noreferrer">
      <Glyph icon="github-logo" motion="commit" />
      <span class="sr-only">{title} source on GitHub</span>
    </a>
  )}
</li>
