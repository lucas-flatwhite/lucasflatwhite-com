---
import Glyph from './Glyph.astro';
import { cropPicture } from '../lib/project-picture';

type Art = {
  image: { src: string; width: number; height: number };
  alt: string;
};

type Props = {
  title: string;
  summary: string;
  tags: readonly string[];
  href: string;
  repo?: string;
  art: Art;
  motion?: 'caret' | 'strokes';
  svg?: string;
  slot?: 'feature' | 'wide';
};

const { title, summary, tags, href, repo, art, motion, svg: picture, slot } = Astro.props;
const ready =
  picture !== undefined &&
  ((motion === 'caret' && picture.includes('id="caret"')) ||
    (motion === 'strokes' && picture.includes('id="strokes"')));
const svg = ready ? cropPicture(picture) : picture;
---

<article class:list={['project-card', 'tile', slot && `slot-${slot}`]}>
  <div class="project-art">
    {ready ? <div class="project-motion" set:html={svg} role="img" aria-label={art.alt} /> : (
      <img
        src={art.image.src}
        width={art.image.width}
        height={art.image.height}
        alt={art.alt}
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  <h3 class="project-title">
    <a href={href} target="_blank" rel="noreferrer">
      {title}
      <Glyph icon="arrow-up-right" class="project-out" />
    </a>
  </h3>
  <p class="project-summary">{summary}</p>
  <p class="project-tags">{tags.join(', ')}</p>
  {repo && (
    <a class="project-source glyph-host" href={repo} target="_blank" rel="noreferrer">
      <Glyph icon="github-logo" motion="commit" />
      Source
    </a>
  )}
</article>
