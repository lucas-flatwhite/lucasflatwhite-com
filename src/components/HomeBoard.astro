---
/*
 * The homepage board: header, name, photos, cards, footer, the dialogs and the command menu.
 * The homepage and /hi/ (where the QR on my card lands) both draw it, so they never drift.
 */
import { getCollection } from 'astro:content';
import ArcadeHandheld from './ArcadeHandheld.astro';
import BoardPhotos from './BoardPhotos.astro';
import BookDialog from './BookDialog.astro';
import BookStand from './BookStand.astro';
import CardDialog from './CardDialog.astro';
import ClaudeMark from './ClaudeMark.astro';
import CommandPalette from './CommandPalette.astro';
import ProjectCard from './ProjectCard.astro';
import SiteHeader from './SiteHeader.astro';
import WorkBadge from './WorkBadge.astro';
import WorkLetter from './WorkLetter.astro';
import CopyMark from './CopyMark.astro';
import CopyRoll from './CopyRoll.astro';
import DailyShotReceipt from './DailyShotReceipt.astro';
import Glyph from './Glyph.astro';
import { book } from '../data/book';
import { dailyShot } from '../data/daily-shot';
import { featuredLinks } from '../data/links';
import { siteProfile } from '../data/site';
import { work } from '../data/work';
import { deckOrder } from '../lib/photos';
import {
  arrangeBoard,
  listOrder,
  NAME_ROWS,
  PHOTO_ROWS,
  placeProjects,
  railOf,
  stackBoard,
} from '../lib/projects';
import { withBase } from '../lib/paths';
import '../styles/landing.css';

const placed = placeProjects(await getCollection('projects'));
const photos = deckOrder(await getCollection('photos'));
// The book, every pictured project, Daily Shot, the arcade, the work badge and the checklist,
// with pinned projects in their numbered slots and gaps after them (src/lib/projects.ts).
const slots = arrangeBoard(placed.board);
const count = slots.length;
const photoRows = photos.length > 0 ? PHOTO_ROWS : 0;
// The board runs three columns on a mid screen and four on a wide one; the spans match. On
// both, the work badge and the checklist stand under the name.
const rail = railOf(slots);
const three = stackBoard(count, 3, NAME_ROWS, photoRows, rail);
const four = stackBoard(count, 4, NAME_ROWS, photoRows, rail);
// A phone shows the list as it is: the book, the badge and the checklist, then the rest.
const listed = listOrder(slots).map((index) => ({ slot: slots[index], index }));
const place = (index: number) =>
  [
    `--c3: ${three[index].column}; --r3: ${three[index].row}`,
    `--c4: ${four[index].column}; --r4: ${four[index].row}`,
    `--span: ${four[index].span}`,
  ].join('; ');
const arcadeHref = withBase('arcade/');
// The book icon stays with the last word of the name, so it never wraps onto a line alone.
const bookWords = book.name.split(' ');
const bookLastWord = bookWords.pop();
const year = new Date().getFullYear();
---

<div class="home-board" data-home-board>
  <SiteHeader href="#top" />
  <main id="top">
    <section class="board">
      <div class="board-grid">
        <div class="board-copy" style={`--span: ${NAME_ROWS}`}>
          <h1 id="name" class="name" data-name aria-label={siteProfile.name}>
            {['Lucas', 'Flatwhite'].map((word) => (
              <span class="name-line" aria-hidden="true">
                {word.split('').map((letter) => (
                  <span data-name-letter><span class="name-letter-face">{letter}</span></span>
                ))}
              </span>
            ))}
          </h1>
          <p class="name-ko" lang="ko">{siteProfile.nameKo}</p>
          <p class="intro">{siteProfile.intro}</p>
          <ul class="name-links">
            {featuredLinks.map((link) => (
              <li>
                {link.copy !== null ? (
                  <a class="glyph-host" href={link.href} data-copy={link.copy}>
                    <CopyMark icon={link.icon} motion={link.motion} />
                    <CopyRoll text={link.label} />
                  </a>
                ) : (
                  <a class="glyph-host" href={link.href} target="_blank" rel="noreferrer me">
                    <Glyph icon={link.icon} motion={link.motion} />
                    {link.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
        {photoRows > 0 && <BoardPhotos photos={photos} rows={photoRows} />}
        <ol class="board-cards" id="work">
          {listed.map(({ slot, index }) =>
            slot.kind === 'book' ? (
              <li class="project-card book-card" style={place(index)}>
                <div class="project-art book-art">
                  <BookStand alt={`My book, ${book.name}, standing on a pale blue ground. Now and then its cover opens a little onto a first page with a large Claude mark.`} />
                </div>
                <span class="project-label" aria-hidden="true"><ClaudeMark />{book.name}</span>
                <div class="project-text">
                  <h3 class="project-title">
                    <button type="button" data-book-open aria-haspopup="dialog" aria-controls="book">
                      <ClaudeMark />{bookWords.join(' ')} <span class="book-name-end">{bookLastWord}<Glyph icon="book-open" class="project-out" /></span>
                    </button>
                  </h3>
                  <p class="project-summary">{book.summary}</p>
                </div>
              </li>
            ) : slot.kind === 'project' ? (
              <ProjectCard
                title={slot.entry.data.title}
                summary={slot.entry.data.summary}
                href={slot.entry.data.href}
                repo={slot.entry.data.repo}
                art={slot.entry.data.art!}
                motion={slot.entry.data.motion}
                place={place(index)}
              />
            ) : slot.kind === 'daily' ? (
              <li class="project-card receipt-card" style={place(index)} data-daily-shot>
                <div class="project-art receipt-art">
                  <DailyShotReceipt />
                </div>
                <span class="project-label" aria-hidden="true">{dailyShot.title}</span>
                <div class="project-text">
                  <h3 class="project-title">
                    <a href={dailyShot.href} target="_blank" rel="noreferrer me">
                      {dailyShot.title}
                      <Glyph icon="arrow-up-right" class="project-out" />
                    </a>
                  </h3>
                  <p class="project-summary">{dailyShot.summary}</p>
                </div>
              </li>
            ) : slot.kind === 'work' ? (
              <li class="project-card work-card" style={place(index)} data-work-card>
                <div class="project-art work-art">
                  <WorkBadge
                    alt={`My badge at ${work.company}, hanging on its cord. Its small screen answers what I do: backend engineering, full-stack development and tech strategy.`}
                    steps={work.scenes.length}
                  />
                </div>
                <span class="project-label" aria-hidden="true">{work.company}</span>
                <div class="project-text">
                  <h3 class="project-title">
                    <button type="button" data-work-open aria-haspopup="dialog" aria-controls="work-letter">
                      {work.company}
                      <Glyph icon="umbrella-simple" class="project-out" />
                    </button>
                  </h3>
                  <p class="project-summary">{work.summary}</p>
                </div>
              </li>
            ) : slot.kind === 'arcade' ? (
              <li class="project-card arcade-card" style={place(index)}>
                <div class="project-art arcade-art">
                  <ArcadeHandheld />
                </div>
                <span class="project-label" aria-hidden="true">Flatwhite Arcade</span>
                <div class="project-text">
                  <h3 class="project-title">
                    <a href={arcadeHref}>Flatwhite Arcade</a>
                  </h3>
                  <p class="project-summary">Small games, one cartridge at a time.</p>
                </div>
              </li>
            ) : (
              <li class="board-gap" style={place(index)} aria-hidden="true" data-checklist={slot.kind === 'checklist' ? '' : undefined}>
                <span class="gap-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="gap-note">{slot.note}</span>
              </li>
            ),
          )}
        </ol>
      </div>
    </section>
  </main>

  <footer class="colophon">
    <div class="colophon-meta">
      <p class="colophon-shortcut">Press <kbd data-palette-key>Ctrl K</kbd> to jump anywhere.</p>
      <p>&copy; {year} {siteProfile.name}</p>
    </div>
  </footer>
  <BookDialog />
  <CardDialog />
  <WorkLetter />
  <CommandPalette />
</div>


<script>
  import { bindBook } from '../lib/book';
  import { bindCard } from '../lib/card';
  import { mountCopyLinks } from '../lib/copy-link';
  import { bindDailyShot } from '../lib/daily-shot';
  import { bindNameSwap } from '../lib/name-swap';
  import { bindPhotoDeck } from '../lib/photo-deck';
  import { mountSnakePreview } from '../lib/snake-preview';
  import { work } from '../data/work';
  import { bindWorkBadge } from '../lib/work-badge';
  import { bindWorkLetter } from '../lib/work-letter';
  import { bindWorkMotion } from '../lib/work-motion';

  const name = document.querySelector<HTMLElement>('[data-name]');
  const preview = document.querySelector<HTMLCanvasElement>('[data-snake-preview]');
  const deck = document.querySelector<HTMLElement>('[data-photo-deck]');
  const receipt = document.querySelector<HTMLElement>('[data-daily-shot]');
  const bookDialog = document.querySelector<HTMLDialogElement>('[data-book-dialog]');
  const workCard = document.querySelector<HTMLElement>('[data-work-card]');
  const workLetter = document.querySelector<HTMLDialogElement>('[data-work-letter]');

  if (preview) {
    mountSnakePreview(preview);
  }

  if (deck) {
    bindPhotoDeck(deck);
  }

  if (receipt) {
    bindDailyShot(receipt);
  }

  if (bookDialog) {
    bindBook(bookDialog, document.querySelectorAll<HTMLElement>('[data-book-open]'));
  }

  const cardDialog = document.querySelector<HTMLDialogElement>('[data-card-dialog]');

  if (cardDialog) {
    bindCard(cardDialog, document.querySelectorAll<HTMLElement>('[data-card-open]'));
  }

  if (workCard && workLetter) {
    bindWorkBadge(workCard, work.scenes, work.visitor, bindWorkLetter(workLetter, workCard.querySelector<HTMLElement>('[data-work-open]')));
  }

  // On /hi/ my card covers the board and unfolds into it (CardIntro.astro). The name swap and
  // the moving pictures wait for it, so no letter turns into a drawing while it travels.
  const ready = document.querySelector('[data-card-intro]')
    ? new Promise<void>((resolve) => window.addEventListener('card-intro:done', () => resolve(), { once: true }))
    : Promise.resolve();

  ready.then(() => {
    if (name) {
      bindNameSwap(name);
    }

    bindWorkMotion(document.querySelectorAll<HTMLElement>('.project-motion'));
  });

  mountCopyLinks();
</script>
