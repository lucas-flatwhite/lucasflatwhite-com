---
/*
 * The book's store list (src/lib/book.ts opens and closes it). On a wide screen it is the
 * book laid open: the left page carries the cover and the title, the right one the stores as
 * a table of contents. Each page has the cover's own shape, so when it opens, the closed
 * cover lies exactly on the right page before it swings over to the left. On a phone, or a
 * screen too short for the spread, the same content rises from the bottom as a sheet.
 */
import { Picture } from 'astro:assets';
import cover from '../assets/book/cover.jpg';
import { book } from '../data/book';
import Glyph from './Glyph.astro';
---

<dialog id="book" class="book-dialog" lang="ko" aria-labelledby="book-dialog-title" data-book-dialog>
  <div class="book-spread">
    <button class="book-close" type="button" data-book-close aria-label="닫기" autofocus>
      <Glyph icon="x" />
    </button>
    <div class="book-leaf">
      <div class="book-leaf-face">
        <div class="book-leaf-cover">
          <Picture src={cover} widths={[320, 480]} sizes="150px" formats={['avif', 'webp']} alt="" loading="eager" fetchpriority="low" decoding="async" />
        </div>
        <h2 class="book-dialog-title" id="book-dialog-title">{book.title}</h2>
        <p class="book-dialog-tagline">{book.tagline}</p>
        <p class="book-dialog-meta">{book.meta}</p>
      </div>
      <div class="book-leaf-back" aria-hidden="true">
        <Picture src={cover} widths={[480, 960]} sizes="430px" formats={['avif', 'webp']} alt="" loading="eager" fetchpriority="low" decoding="async" />
      </div>
    </div>
    <div class="book-stores">
      <p class="book-eyebrow">WHERE TO GET IT</p>
      <h3 class="book-stores-heading">구매처</h3>
      <ol class="book-store-list">
        {book.stores.map((store, index) => (
          <li style={`--row: ${index}`}>
            <a class="book-store glyph-host" href={store.href} target="_blank" rel="noopener noreferrer">
              <span class="book-store-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="book-store-name">{store.name}</span>
              {store.tag && <span class="book-store-tag">{store.tag}</span>}
              <span class="book-store-dots" aria-hidden="true"></span>
              <span class="book-store-host">{store.host}</span>
              <Glyph icon="arrow-up-right" class="book-store-out" />
            </a>
          </li>
        ))}
      </ol>
      <p class="book-stores-foot">링크는 새 탭에서 열려요.</p>
    </div>
  </div>
</dialog>

<style is:global>
  .book-dialog {
    max-width: none;
    max-height: none;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    color: #171717;
    font-family: var(--font-ko);
  }

  /* Opened from the address, the dialog itself can take focus; the ring belongs on its buttons. */
  .book-dialog:focus {
    outline: none;
  }

  .book-dialog::backdrop {
    background: rgba(23, 23, 23, 0.4);
  }

  /* The page behind holds still while the book is open. */
  html:has(.book-dialog[open]) {
    overflow: hidden;
  }

  .book-spread {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: min(860px, calc(100vw - 48px), calc((100dvh - 48px) * 1.517));
  }

  .book-leaf,
  .book-stores {
    position: relative;
    aspect-ratio: 2106 / 2777;
  }

  .book-leaf {
    z-index: 1;
    transform-origin: 100% 50%;
    transform-style: preserve-3d;
  }

  /* The shadow sits on each page, so it moves with the page instead of being redrawn. */
  .book-leaf-face,
  .book-leaf-back,
  .book-stores {
    box-shadow: 0 30px 60px rgba(23, 23, 23, 0.2), 0 2px 6px rgba(23, 23, 23, 0.08);
  }

  .book-leaf-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 13% 9% 9% 10%;
    border-radius: 6px 0 0 6px;
    background: linear-gradient(270deg, rgba(23, 23, 23, 0.1), rgba(23, 23, 23, 0) 9%), #fbfaf6;
    backface-visibility: hidden;
  }

  .book-leaf-back {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 0 6px 6px 0;
    background: #fff;
    transform: rotateY(180deg);
    backface-visibility: hidden;
  }

  .book-leaf-back :is(picture, img),
  .book-leaf-cover :is(picture, img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .book-leaf-cover {
    flex: none;
    width: 35%;
    height: auto;
    aspect-ratio: 2106 / 2777;
    margin-bottom: 7%;
    box-shadow: 0 1px 2px rgba(23, 23, 23, 0.12), 0 10px 22px rgba(23, 23, 23, 0.14);
  }

  .book-dialog-title {
    margin: 0;
    font-size: clamp(17px, 2.5vw, 21px);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.32;
    word-break: keep-all;
  }

  .book-dialog-tagline {
    margin: 10px 0 0;
    color: #4d4d4d;
    font-size: 13.5px;
    line-height: 1.6;
    word-break: keep-all;
  }

  .book-dialog-meta {
    margin: auto 0 0;
    padding-top: 12px;
    color: #77736a;
    font-size: 12.5px;
  }

  .book-stores {
    display: flex;
    flex-direction: column;
    padding: 13% 10% 9% 9%;
    border-radius: 0 6px 6px 0;
    background: linear-gradient(90deg, rgba(23, 23, 23, 0.1), rgba(23, 23, 23, 0) 9%), #fbfaf6;
  }

  .book-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgba(23, 23, 23, 0.06);
    color: #171717;
    font-size: 16px;
    cursor: pointer;
  }

  .book-close:hover {
    background: rgba(23, 23, 23, 0.12);
  }

  .book-close:focus-visible,
  .book-store:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .book-eyebrow {
    margin: 0;
    color: var(--blue);
    font-family: var(--font-display);
    font-size: 11px;
    font-stretch: 110%;
    font-weight: 640;
    letter-spacing: 0.16em;
  }

  .book-stores-heading {
    margin: 6px 0 18px;
    font-size: clamp(21px, 3vw, 26px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .book-store-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book-store {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: clamp(9px, 1.6vh, 14px) 2px;
    border-radius: 6px;
    color: inherit;
    text-decoration: none;
  }

  .book-store-number {
    width: 20px;
    color: #a39f95;
    font-family: var(--font-display);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .book-store-name {
    font-size: 17px;
    font-weight: 650;
  }

  .book-store-name,
  .book-store-tag {
    white-space: nowrap;
  }

  .book-store-tag {
    padding: 1px 7px;
    border: 1px solid rgba(31, 53, 181, 0.35);
    border-radius: var(--radius-pill);
    color: var(--blue);
    font-size: 11px;
    font-weight: 600;
  }

  .book-store-dots {
    flex: 1;
    min-width: 16px;
    border-bottom: 1.5px dotted #c9c5bb;
    translate: 0 -4px;
  }

  .book-store-host {
    color: #8b877d;
    font-family: var(--font-display);
    font-size: 12.5px;
  }

  .book-store .book-store-out {
    font-size: 15px;
    translate: 0 2px;
  }

  .book-store:is(:hover, :focus-visible) .book-store-name {
    color: var(--blue);
  }

  .book-store:is(:hover, :focus-visible) .book-store-dots {
    border-color: var(--blue);
  }

  .book-stores-foot {
    margin: auto 0 0;
    padding-top: 12px;
    color: #a39f95;
    font-size: 12px;
  }

  /* On a narrow spread the addresses would crowd the names, so only the names stay. */
  @media (max-width: 960px) {
    .book-store-host {
      display: none;
    }
  }

  /* A phone, or a screen too short for the spread: the same content as a sheet. */
  @media (max-width: 720px), (max-height: 560px) {
    .book-dialog {
      width: min(100%, 560px);
      margin: auto auto 0;
    }

    .book-spread {
      display: block;
      width: 100%;
      max-height: 88dvh;
      overflow-y: auto;
      padding: 22px 18px max(24px, env(safe-area-inset-bottom));
      border-radius: var(--radius-card) var(--radius-card) 0 0;
      background: #fbfaf6;
    }

    .book-close {
      top: 18px;
      right: 14px;
    }

    .book-leaf,
    .book-stores {
      aspect-ratio: auto;
    }

    .book-leaf-face {
      position: static;
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      align-items: center;
      gap: 6px 14px;
      padding: 0 44px 16px 0;
      border-bottom: 1px dotted #c9c5bb;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }

    .book-leaf-cover {
      grid-row: span 2;
      width: 64px;
      margin: 0;
    }

    .book-dialog-title {
      align-self: end;
      font-size: 15.5px;
    }

    .book-dialog-tagline,
    .book-leaf-back,
    .book-store-host {
      display: none;
    }

    .book-dialog-meta {
      align-self: start;
      margin: 0;
      padding: 0;
      font-size: 11.5px;
    }

    .book-stores {
      padding: 16px 0 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }

    .book-stores-heading {
      margin-bottom: 4px;
      font-size: 20px;
    }

    .book-store {
      padding: 11px 0;
    }

    .book-store-name {
      font-size: 15.5px;
    }

    .book-stores-foot {
      padding-top: 10px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .book-dialog[open]::backdrop {
      animation: book-dialog-fade 240ms var(--ease-out);
    }

    .book-dialog.is-closing {
      animation: book-dialog-out 170ms ease-in forwards;
    }

    .book-dialog:is(.is-shutting, .is-closing)::backdrop {
      animation: book-dialog-fade-out 790ms ease-in forwards;
    }

    .book-store-out {
      transition: translate var(--dur-short) var(--ease-out);
    }

    .book-store:is(:hover, :focus-visible) .book-store-out {
      translate: 2px 0;
    }

    /* The closed book starts in the middle of the screen and slides left as its cover opens. */
    @media (min-width: 721px) and (min-height: 561px) {
      .book-dialog[open] .book-spread {
        animation: book-dialog-center 1000ms cubic-bezier(0.5, 0, 0.2, 1) 140ms both;
      }

      .book-dialog[open] .book-leaf {
        animation: book-dialog-open 1000ms cubic-bezier(0.5, 0, 0.2, 1) 140ms both;
      }

      .book-dialog[open] :is(.book-eyebrow, .book-stores-heading, .book-close, .book-stores-foot) {
        animation: book-dialog-row 420ms var(--ease-out) 900ms both;
      }

      .book-dialog[open] .book-store-list li {
        animation: book-dialog-row 420ms var(--ease-out) both;
        animation-delay: calc(980ms + var(--row) * 70ms);
      }

      .book-dialog.is-shutting .book-spread {
        animation: book-dialog-uncenter 620ms cubic-bezier(0.5, 0, 0.2, 1) both;
      }

      .book-dialog.is-shutting .book-leaf {
        animation: book-dialog-shut 620ms cubic-bezier(0.5, 0, 0.2, 1) both;
      }
    }

    @media (max-width: 720px), (max-height: 560px) {
      .book-dialog[open] .book-spread {
        animation: book-dialog-rise 520ms var(--ease-out) both;
      }

      .book-dialog[open] .book-store-list li {
        animation: book-dialog-row 380ms var(--ease-out) both;
        animation-delay: calc(300ms + var(--row) * 60ms);
      }
    }
  }

  @keyframes book-dialog-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes book-dialog-fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes book-dialog-out {
    to {
      opacity: 0;
      transform: translateY(6px) scale(0.985);
    }
  }

  @keyframes book-dialog-center {
    from {
      transform: translateX(-25%);
    }

    to {
      transform: none;
    }
  }

  @keyframes book-dialog-uncenter {
    from {
      transform: none;
    }

    to {
      transform: translateX(-25%);
    }
  }

  @keyframes book-dialog-open {
    from {
      transform: perspective(1800px) rotateY(180deg);
    }

    to {
      transform: perspective(1800px) rotateY(0deg);
    }
  }

  @keyframes book-dialog-shut {
    from {
      transform: perspective(1800px) rotateY(0deg);
    }

    to {
      transform: perspective(1800px) rotateY(180deg);
    }
  }

  @keyframes book-dialog-row {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes book-dialog-rise {
    from {
      transform: translateY(100%);
    }
  }
</style>
