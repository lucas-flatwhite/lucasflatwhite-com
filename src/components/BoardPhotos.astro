---
// The photos beside the name. They take turns in one frame, each with its caption
// (photo-deck.ts); without script the first one stays up. The first is above the fold on
// every screen, so it loads at once; the rest wait.
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';

type Props = {
  photos: CollectionEntry<'photos'>[];
  rows: number;
};

const { photos, rows } = Astro.props;
// Two of four columns on a wide board, two of three on a mid one, the full width otherwise.
const sizes = [
  '(min-width: 1100px) and (hover: hover) 50vw',
  '(min-width: 721px) and (hover: hover) 67vw',
  '100vw',
].join(', ');
// sharp's AVIF default (50) smooths skin and wall texture away; 64 keeps them at about 26 kB.
const quality = 64;
---

<div
  class="board-photos"
  style={`--span: ${rows}; --photo-count: ${photos.length}`}
  role="region"
  aria-roledescription="carousel"
  aria-label="Photos"
  data-photo-deck
>
  {photos.map(({ data }, index) => (
    <figure
      class:list={['photo-slide', { 'is-current': index === 0 }]}
      aria-hidden={index === 0 ? undefined : 'true'}
      data-photo-slide
    >
      <Picture
        src={data.image}
        alt={data.alt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600, 2000]}
        sizes={sizes}
        quality={quality}
        priority={index === 0}
        style={data.position && `object-position: ${data.position}`}
      />
      <figcaption class="photo-caption">{data.caption}</figcaption>
    </figure>
  ))}
  {photos.length > 1 && (
    <ol class="photo-dots">
      {photos.map(({ data }, index) => (
        <li>
          <button
            type="button"
            class="photo-dot"
            aria-label={`Photo ${index + 1} of ${photos.length}: ${data.caption}`}
            aria-current={index === 0 ? 'true' : 'false'}
            data-photo-dot
          ></button>
        </li>
      ))}
    </ol>
  )}
</div>
