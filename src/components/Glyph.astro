---
import type { GlyphMotion } from '../data/links';
import { icons, type IconName } from '../lib/icons';

type Props = {
  icon: IconName;
  motion?: GlyphMotion;
  class?: string;
};

const { icon, motion = 'lift', class: className } = Astro.props;
const { regular, bold } = icons[icon];
---

<span class:list={['glyph', className]} data-motion={motion} aria-hidden="true">
  <span class="glyph-weight glyph-regular" set:html={regular} />
  <span class="glyph-weight glyph-bold" set:html={bold} />
</span>

<style is:global>
  /*
   * A glyph is a Phosphor icon in two weights. Its trigger (any ancestor marked
   * .glyph-host) crossfades regular to bold while the label beside it widens on the
   * font's width axis, then the glyph performs the verb of the place it links to.
   */
  .glyph {
    position: relative;
    display: inline-grid;
    flex: none;
    width: 1em;
    height: 1em;
    color: currentColor;
  }

  .glyph-weight {
    grid-area: 1 / 1;
    display: block;
    transition: opacity var(--dur-short) var(--ease-out);
  }

  .glyph-weight svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .glyph-bold {
    opacity: 0;
  }

  .glyph-host:is(:hover, :focus-visible) .glyph-regular {
    opacity: 0;
  }

  .glyph-host:is(:hover, :focus-visible) .glyph-bold {
    opacity: 1;
  }

  /* commit: a crema commit lands on a branch line drawn under the mark. */
  .glyph[data-motion='commit']::before,
  .glyph[data-motion='commit']::after {
    content: '';
    position: absolute;
    top: calc(100% + 0.16em);
    left: 0;
    pointer-events: none;
  }

  .glyph[data-motion='commit']::before {
    width: 100%;
    height: 0.06em;
    min-height: 1px;
    background: var(--crema);
    transform: scaleX(0);
    transform-origin: left;
  }

  .glyph[data-motion='commit']::after {
    width: 0.2em;
    height: 0.2em;
    margin-top: -0.07em;
    background: var(--crema);
    opacity: 0;
  }

  /* cross: the bold mark is revealed along its own diagonal stroke. */
  .glyph[data-motion='cross'] .glyph-bold {
    clip-path: polygon(0 0, 0 0, 0 0);
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .glyph-host:is(:hover, :focus-visible) .glyph[data-motion='commit']::before {
      transform: scaleX(1);
      transition: transform var(--dur-long) var(--ease-out);
    }

    .glyph-host:is(:hover, :focus-visible) .glyph[data-motion='commit']::after {
      animation: glyph-commit var(--dur-long) var(--ease-out) 120ms forwards;
    }

    .glyph[data-motion='cross'] .glyph-bold {
      transition: clip-path var(--dur-long) var(--ease-out);
    }

    .glyph-host:is(:hover, :focus-visible) .glyph[data-motion='cross'] .glyph-bold {
      clip-path: polygon(0 0, 200% 0, 0 200%);
    }

    .glyph-host:is(:hover, :focus-visible) .glyph[data-motion='cross'] .glyph-regular {
      opacity: 0.35;
    }

    .glyph-host:is(:hover, :focus-visible) .glyph[data-motion='lift'] {
      transform: translate(0.08em, -0.08em);
      transition: transform var(--dur-short) var(--ease-out);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph[data-motion='cross'] .glyph-bold {
      clip-path: none;
      opacity: 0;
    }

    .glyph-host:is(:hover, :focus-visible) .glyph[data-motion='cross'] .glyph-bold {
      opacity: 1;
    }
  }

  @keyframes glyph-commit {
    from {
      opacity: 1;
      transform: translateX(0);
    }

    to {
      opacity: 1;
      transform: translateX(calc(1em - 0.2em));
    }
  }
</style>
