---
import { getCollection } from 'astro:content';
import CopyMark from './CopyMark.astro';
import CopyRoll from './CopyRoll.astro';
import Glyph from './Glyph.astro';
import { sectionIds } from '../data/site';
import { buildPaletteCommands } from '../lib/command-actions';
import { withBase } from '../lib/paths';
import { placeProjects } from '../lib/projects';

const projects = placeProjects(await getCollection('projects')).palette.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  tags: entry.data.tags,
  href: entry.data.href,
  order: entry.data.order,
  featured: entry.data.featured,
}));

const commands = buildPaletteCommands(withBase(), withBase('arcade/'), sectionIds, projects);
---

<dialog class="palette" data-palette aria-label="Command menu">
  <div class="palette-field">
    <label for="palette-input">Jump to</label>
    <input
      id="palette-input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      data-palette-input
    />
    <kbd class="palette-esc">Esc</kbd>
  </div>
  <ul class="palette-list" id="palette-list" role="listbox" aria-label="Commands" data-palette-list>
    {
      commands.map((command) => (
        <li
          class="palette-option glyph-host"
          id={`palette-${command.id}`}
          role="option"
          aria-selected="false"
          data-href={command.href}
          data-external={command.external ? 'true' : undefined}
          data-copy={command.copy ?? undefined}
          data-search={`${command.label} ${command.hint}`.toLowerCase()}
        >
          {command.copy !== null ? <CopyMark icon={command.icon} /> : <Glyph icon={command.icon} />}
          <span class="palette-label">{command.label}</span>
          <span class="palette-hint">
            {command.copy !== null ? <CopyRoll text={command.hint} /> : command.hint}
          </span>
          {command.external && <Glyph icon="arrow-up-right" class="palette-out" />}
        </li>
      ))
    }
  </ul>
  <p class="palette-empty" data-palette-empty hidden>Nothing matches that.</p>
</dialog>

<style is:global>
  .palette-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 40px;
    padding: 0 0.8em;
    border: 1px solid var(--line, #ebebeb);
    border-radius: 6px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition:
      background-color var(--dur-short) var(--ease-out),
      color var(--dur-short) var(--ease-out);
  }

  .palette-trigger[hidden] {
    display: none;
  }

  .palette-trigger:hover {
    background: #ebebeb;
    color: #171717;
  }

  .palette-trigger:active {
    transform: translateY(1px);
  }

  .palette {
    width: min(560px, calc(100vw - 32px));
    max-height: min(520px, calc(100dvh - 64px));
    margin: 12vh auto auto;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: #fff;
    color: #171717;
    box-shadow: 0 0 0 1px #ebebeb;
    overflow: hidden;
  }

  .palette::backdrop {
    background: rgba(23, 23, 23, 0.4);
  }

  .palette[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .palette[open] {
      animation: palette-in var(--dur-short) var(--ease-out);
    }
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
      clip-path: inset(0 0 100% 0);
    }

    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 0 0);
    }
  }

  .palette-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid #ebebeb;
  }

  .palette-field label {
    flex: none;
    font-stretch: 80%;
    font-weight: 700;
  }

  .palette-field input {
    flex: 1;
    min-width: 0;
    padding: 0.2rem 0;
    border: 0;
    background: transparent;
    color: #171717;
    font: inherit;
    font-size: 1.05rem;
    caret-color: #171717;
  }

  .palette-field input:focus {
    outline: none;
  }

  .palette-field:focus-within {
    box-shadow: inset 0 -2px 0 #171717;
  }

  .palette-esc {
    flex: none;
    font-size: 0.8rem;
    color: #4d4d4d;
  }

  .palette-list {
    margin: 0;
    padding: 0.4rem 0;
    list-style: none;
    overflow-y: auto;
  }

  .palette-option {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 1.1rem;
    font-size: 1.15rem;
    cursor: pointer;
  }

  .palette-option[hidden] {
    display: none;
  }

  .palette-option .glyph {
    font-size: 1.3rem;
  }

  .palette-label {
    font-weight: 600;
    transition:
      font-stretch var(--dur-short) var(--ease-out),
      font-weight var(--dur-short) var(--ease-out);
  }

  .palette-hint {
    overflow: hidden;
    color: #4d4d4d;
    font-size: 0.9rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette-option[aria-selected='true'] {
    background: #171717;
    color: #fff;
  }

  .palette-option[aria-selected='true'] .palette-hint,
  .palette-option[aria-selected='true'] .copy-roll-done,
  .palette-option[aria-selected='true'] .copy-mark-check {
    color: #fff;
  }

  .palette-option .copy-roll-done,
  .palette-option .copy-mark-check {
    color: #171717;
  }

  .palette-option[aria-selected='true'] .palette-label {
    font-stretch: 125%;
    font-weight: 800;
  }

  .palette-option[aria-selected='true'] .glyph-regular {
    opacity: 0;
  }

  .palette-option[aria-selected='true'] .glyph-bold {
    opacity: 1;
  }

  .palette-empty {
    margin: 0;
    padding: 1rem 1.1rem 1.4rem;
    color: #4d4d4d;
  }
</style>

<script>
  import { clearCopied, copyText, showCopied } from '../lib/copy-link';

  // Any button with [data-palette-open] opens the menu; Cmd/Ctrl+K works on every page.
  // A copy command stays open long enough to show "Copied" in its own row, then closes.
  const COPY_CLOSE_MS = 900;
  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]');
  const input = document.querySelector<HTMLInputElement>('[data-palette-input]');
  const empty = document.querySelector<HTMLElement>('[data-palette-empty]');
  const options = [...document.querySelectorAll<HTMLLIElement>('.palette-option')];
  const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent);

  for (const key of document.querySelectorAll<HTMLElement>('[data-palette-key]')) {
    key.textContent = isMac ? '⌘K' : 'Ctrl K';
  }

  let visible = options;
  let active = 0;

  const select = (index: number) => {
    active = visible.length === 0 ? -1 : (index + visible.length) % visible.length;

    options.forEach((option) => option.setAttribute('aria-selected', 'false'));

    const current = visible[active];

    if (current && input) {
      current.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', current.id);
      current.scrollIntoView({ block: 'nearest' });
    } else {
      input?.removeAttribute('aria-activedescendant');
    }
  };

  const filter = () => {
    const query = (input?.value ?? '').trim().toLowerCase();
    visible = options.filter((option) => {
      const match = !query || (option.dataset.search ?? '').includes(query);
      option.hidden = !match;
      return match;
    });

    if (empty) {
      empty.hidden = visible.length > 0;
    }

    select(0);
  };

  let closeTimer = 0;

  const run = async (option: HTMLLIElement | undefined) => {
    const href = option?.dataset.href;

    if (!href || !dialog) {
      return;
    }

    const copy = option.dataset.copy;

    if (copy !== undefined) {
      if (await copyText(copy)) {
        showCopied(option, `Copied ${copy}`);
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => dialog.close(), COPY_CLOSE_MS);
        return;
      }

      // The clipboard was refused, so the mailto opens a mail app instead.
      dialog.close();
      window.location.assign(href);
      return;
    }

    dialog.close();

    if (option.dataset.external) {
      window.open(href, '_blank', 'noopener');
    } else {
      window.location.assign(href);
    }
  };

  const open = () => {
    if (!dialog || !input || dialog.open) {
      return;
    }

    window.clearTimeout(closeTimer);
    options.forEach(clearCopied);
    input.value = '';
    filter();
    dialog.showModal();
    input.focus();
  };

  if (dialog && input) {
    for (const trigger of document.querySelectorAll<HTMLButtonElement>('[data-palette-open]')) {
      trigger.hidden = false;
      trigger.addEventListener('click', open);
    }

    window.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();

        if (dialog.open) {
          dialog.close();
        } else {
          open();
        }
      }
    });

    input.addEventListener('input', filter);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        select(active + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        select(active - 1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        void run(visible[active]);
      }
    });

    options.forEach((option) => {
      option.addEventListener('pointermove', () => {
        const index = visible.indexOf(option);

        if (index !== active) {
          select(index);
        }
      });
      option.addEventListener('click', () => void run(option));
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  }
</script>
