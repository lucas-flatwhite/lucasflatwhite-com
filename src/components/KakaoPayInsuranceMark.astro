---
// Kakao Pay Insurance's English wordmark, as the company's own site serves it
// (static.kakaoinsure.com/corp/images/common/logo.svg), redrawn in currentColor so the badge
// can print it white and the letter can sign with it in ink. A logo, not an icon.
import mark from '../assets/brand/kakaopay-insurance.svg?raw';

type Props = { class?: string };

const { class: className } = Astro.props;
---

<span class:list={['kpi-mark', className]} set:html={mark} />
