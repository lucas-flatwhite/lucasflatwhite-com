---
// The conversation reserves each message's final size and line breaks while its words are typed.
// It closes on three panes of glass with light passing behind them (src/lib/work-letter.ts plays it).
import { workLetters } from '../data/work';
import Glyph from './Glyph.astro';

// Each pane holds its own copy of the lights, lined up with the ones behind it, so the glass
// looks frosted without a live blur that a phone would have to redraw on every frame.
const lights = ['is-cool', 'is-sun', 'is-crema'];
const rings = Array.from({ length: 44 }, (_, i) => 10 + i * 8);
---

<dialog id="work-letter" class="work-letter" lang="en" aria-labelledby="work-letter-title-en" data-work-letter>
  <div class="work-letter-toolbar">
    <div class="work-letter-languages" role="group" aria-label="Language" data-work-language-group>
      <button type="button" lang="en" aria-label="English" aria-pressed="true" data-work-language="en">EN</button>
      <button type="button" lang="ko" aria-label="한국어" aria-pressed="false" data-work-language="ko">KO</button>
    </div>
    <button class="work-letter-close" type="button" data-work-letter-close aria-label="Close" autofocus><Glyph icon="x" /></button>
  </div>
  <div class="work-letter-sheet" data-work-letter-sheet>
    {Object.entries(workLetters).map(([language, letter]) => (
      <section lang={language} data-work-language-panel={language} hidden={language !== 'en'}>
        <p class="work-letter-eyebrow">{letter.eyebrow}</p>
        <h2 class="work-letter-title" id={`work-letter-title-${language}`}>{letter.title}</h2>
        <div class="sr-only">
          {letter.turns.map(([question, answer]) => <p>{question} {answer}</p>)}
          <p>{letter.really}</p>
          <p>{letter.pledge.map(([text]) => text).join('')}</p>
          <p>{letter.waiting}</p>
        </div>
        <div class="work-letter-thread" aria-hidden="true">
          {letter.turns.map(([question, answer]) => (
            <div class="work-letter-turn">
              <p class="work-letter-q">
                <span class="work-letter-reserve">{question}</span>
                <span class="work-letter-typed" data-work-text={question}>{question}</span>
              </p>
              <p class="work-letter-a">
                <span class="work-letter-reserve">{answer}</span>
                <span class="work-letter-typed" data-work-text={answer}>{answer}</span>
                <span class="work-letter-think"><i></i><i></i><i></i></span>
              </p>
            </div>
          ))}
        </div>
        <p class="work-letter-really" data-work-letter-step aria-hidden="true">{letter.really}</p>
        <p class="work-letter-pledge" data-work-letter-step aria-hidden="true">
          {letter.pledge.map(([text, marked]) => marked ? <span class="work-letter-mark">{text}</span> : text)}
        </p>
        <p class="work-letter-waiting" data-work-letter-step aria-hidden="true">{letter.waiting}</p>
        <div class="work-letter-glass" data-work-letter-step aria-hidden="true">
          <svg class="work-letter-rings" width="100%" height="100%">
            {rings.map((r) => <circle cx="50%" cy="50%" r={r} />)}
          </svg>
          {lights.map((light) => <span class={`work-letter-light ${light}`}></span>)}
          {[-1, 0, 1].map((i) => (
            <span class="work-letter-pane" style={`--i: ${i}`}>
              {lights.map((light) => <span class={`work-letter-light ${light}`}></span>)}
              <span class="work-letter-sheen"></span>
            </span>
          ))}
        </div>
        <div class="work-letter-foot">
          <a class="work-letter-company" href="https://kakaopayinscorp.co.kr/" target="_blank" rel="noopener noreferrer"><span class="work-letter-company-text">kakaopayinscorp.co.kr</span><span class="work-letter-company-arrow" aria-hidden="true"><Glyph icon="arrow-up-right" /></span></a>
          <button class="work-letter-replay" type="button" data-work-letter-replay>{letter.replay} <span aria-hidden="true">↺</span></button>
        </div>
      </section>
    ))}
  </div>
</dialog>

<style is:global>
  .work-letter {
    width: min(600px, calc(100vw - 32px));
    height: min(860px, calc(100dvh - 48px));
    max-width: none;
    max-height: none;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 6px;
    background: #fbfaf6;
    color: #171717;
    font-family: var(--font-ko);
    box-shadow: 0 30px 60px rgba(23, 23, 23, 0.2);
  }
  .work-letter:focus { outline: none; }
  .work-letter::backdrop { background: rgba(23, 23, 23, 0.4); }
  html:has(.work-letter[open]) { overflow: hidden; }
  /*
   * A slim bar: the languages are words, and the chosen one carries the letter's highlighter.
   * Each control looks small but takes the bar's full height and at least 44px across, so a
   * thumb lands on it easily.
   */
  .work-letter-toolbar {
    height: 44px;
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    padding: 0 4px;
    border-bottom: 1px solid #e8e5dc;
  }
  .work-letter [hidden] { display: none !important; }
  .work-letter-languages { display: flex; }
  .work-letter-languages button {
    position: relative;
    z-index: 0;
    min-width: 44px;
    padding: 0 13px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #6b675f;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .work-letter-languages button:hover { color: #171717; }
  .work-letter-languages button[aria-pressed="true"] { color: #171717; }
  .work-letter-languages button[aria-pressed="true"]::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: calc(50% + 1px);
    right: 13px;
    left: 13px;
    height: 6px;
    background: #ffeb00;
  }
  /* Close shows a 30px circle on hover, inside a 44px target. */
  .work-letter-close {
    position: relative;
    z-index: 0;
    display: grid;
    place-items: center;
    width: 44px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #171717;
    font-size: 14px;
    cursor: pointer;
  }
  .work-letter-close::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: calc(50% - 15px);
    left: calc(50% - 15px);
    width: 30px;
    height: 30px;
    border-radius: var(--radius-pill);
  }
  .work-letter-close:hover::before { background: rgba(23, 23, 23, 0.06); }
  .work-letter .work-letter-toolbar button:focus-visible { outline-offset: -4px; }
  .work-letter-replay:hover { box-shadow: inset 0 0 0 1px #aaa69c; }
  .work-letter button:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .work-letter-sheet {
    height: calc(100% - 44px);
    box-sizing: border-box;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    padding: 28px 40px 0;
  }
  .work-letter-sheet > section { display: flex; flex-direction: column; min-height: 100%; }
  .work-letter-eyebrow {
    margin: 0;
    color: var(--blue);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 640;
    letter-spacing: 0.16em;
  }
  .work-letter-title { margin: 8px 0 26px; font-size: 25px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.3; text-wrap: balance; }
  .work-letter-thread { display: grid; gap: 22px; }
  .work-letter-turn { display: grid; gap: 10px; }
  .work-letter-q, .work-letter-a { position: relative; display: grid; margin: 0; }
  .work-letter-reserve, .work-letter-typed { grid-area: 1 / 1; }
  .work-letter-reserve { visibility: hidden; }
  .work-letter-typed { align-self: start; }
  .work-letter-think { position: absolute; inset: 0 auto auto 0; display: none; align-items: center; gap: 6px; height: 1.4em; }
  .work-letter-turn.is-thinking .work-letter-think { display: flex; }
  .work-letter-think i { width: 6px; height: 6px; border-radius: var(--radius-pill); background: currentColor; opacity: 0.4; }
  .work-letter-q {
    justify-self: end;
    max-width: 85%;
    padding: 9px 14px;
    border-radius: var(--radius-card);
    background: #1b1b1b;
    color: #f1f0eb;
    font-size: 14px;
    line-height: 1.5;
  }
  .work-letter-a { font-size: 21px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.4; word-break: keep-all; text-wrap: pretty; }
  .work-letter-really { margin: 16px 0 0; color: #68645d; font-size: 15px; }
  .work-letter-pledge, .work-letter-waiting { margin: 24px 0 0; padding-top: 20px; border-top: 1px dotted #c9c5bb; }
  .work-letter-pledge { font-size: 21px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.7; word-break: keep-all; text-wrap: pretty; }
  /* Inline, so a phrase such as "when you need it most" wraps like the words around it. */
  .work-letter-mark {
    padding: 0 2px;
    background: linear-gradient(#ffeb00, #ffeb00) left bottom 0.12em / 100% 0.48em no-repeat;
  }
  .work-letter-waiting { font-size: 18px; font-weight: 700; line-height: 1.5; text-wrap: pretty; }
  /*
   * The glass that closes the letter runs to both edges of the sheet. Behind it, fine rings
   * and three lights; each pane carries its own copy of the lights, placed so they line up
   * with the ones behind it, and a veil over them, so the glass reads as frosted without a
   * live blur. The light is a radial gradient, already soft. Paper-coloured fades melt the
   * edges into the sheet. Everything rests where it ends, so a reduced-motion visitor sees
   * the finished picture; src/lib/work-letter.ts moves it in by transform and opacity only.
   */
  .work-letter-glass {
    --pane-w: 118px;
    --pane-h: 88px;
    --glass-pitch: 134px;
    position: relative;
    height: 168px;
    margin: 8px -40px 0;
    overflow: hidden;
  }
  .work-letter-glass::before,
  .work-letter-glass::after {
    content: '';
    position: absolute;
    z-index: 3;
    inset: 0;
    pointer-events: none;
  }
  .work-letter-glass::before { background: linear-gradient(to right, #fbfaf6, rgba(251, 250, 246, 0) 10%, rgba(251, 250, 246, 0) 90%, #fbfaf6); }
  .work-letter-glass::after { background: linear-gradient(#fbfaf6, rgba(251, 250, 246, 0) 21%, rgba(251, 250, 246, 0) 79%, #fbfaf6); }
  .work-letter-rings { position: absolute; inset: 0; fill: none; stroke: rgba(23, 23, 23, 0.085); stroke-width: 1; }
  .work-letter-light {
    position: absolute;
    top: 50%;
    left: calc(50% + var(--light-x));
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    border-radius: var(--radius-pill);
  }
  .work-letter-light.is-sun {
    --light-x: 0px;
    --size: 230px;
    background: radial-gradient(closest-side, #fff27a 0%, #ffeb00 42%, rgba(255, 196, 87, 0.75) 74%, rgba(255, 196, 87, 0) 100%);
  }
  .work-letter-light.is-crema {
    --light-x: var(--glass-pitch);
    --size: 170px;
    background: radial-gradient(closest-side, rgba(255, 196, 87, 0.95) 0%, rgba(255, 160, 70, 0.55) 60%, rgba(255, 160, 70, 0) 100%);
  }
  .work-letter-light.is-cool {
    --light-x: calc(var(--glass-pitch) * -1.3);
    --size: 190px;
    background: radial-gradient(closest-side, rgba(184, 193, 238, 0.8) 0%, rgba(184, 193, 238, 0) 100%);
  }
  .work-letter-pane {
    position: absolute;
    z-index: 1;
    top: calc(50% - var(--pane-h) / 2);
    left: calc(50% + var(--i) * var(--glass-pitch) - var(--pane-w) / 2);
    width: var(--pane-w);
    height: var(--pane-h);
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-card);
    background: rgba(251, 250, 246, 0.9);
    box-shadow: 0 14px 28px rgba(23, 23, 23, 0.09);
  }
  /* Inside a pane, a light sits where the same light stands behind the glass. */
  .work-letter-pane .work-letter-light {
    top: calc(var(--pane-h) / 2);
    left: calc(var(--light-x) - var(--i) * var(--glass-pitch) + var(--pane-w) / 2);
  }
  .work-letter-pane::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: var(--radius-card);
    background: linear-gradient(140deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.16) 60%, rgba(255, 255, 255, 0.3));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.95), inset 0 -10px 24px rgba(255, 255, 255, 0.18);
  }
  .work-letter-sheen {
    position: absolute;
    z-index: 2;
    inset: -40%;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.75) 50%, rgba(255, 255, 255, 0) 60%);
    transform: translateX(-120%);
  }
  /* The company link stays in view while the conversation plays; Meet again waits for the end. */
  .work-letter-foot {
    position: sticky;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-sizing: border-box;
    min-height: 56px;
    margin-top: auto;
    padding-bottom: env(safe-area-inset-bottom);
    border-top: 1px solid #e8e5dc;
    background: #fbfaf6;
  }
  .work-letter.is-playing .work-letter-replay { visibility: hidden; opacity: 0; }
  /* On a short screen the bar would take too much of the letter, so it rests at the end. */
  @media (max-height: 560px) {
    .work-letter-foot { position: static; }
  }
  /* The company link: bold, with an arrow, and the highlighter once the glass hands over to it. */
  .work-letter-company { display: inline-flex; align-items: center; gap: 8px; color: #171717; font-size: 14px; font-weight: 700; text-decoration: none; }
  .work-letter-company-text {
    padding: 0 2px;
    background: linear-gradient(#ffeb00, #ffeb00) left bottom 0.1em / 0% 0.5em no-repeat;
  }
  .work-letter-company.is-marked .work-letter-company-text { background-size: 100% 0.5em; }
  .work-letter-company:hover .work-letter-company-text { text-decoration: underline; text-underline-offset: 3px; }
  .work-letter-company-arrow {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-pill);
    background: #171717;
    color: #fbfaf6;
    font-size: 12px;
  }
  .work-letter-company:hover .work-letter-company-arrow { background: var(--blue); }
  .work-letter-company:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  .work-letter-replay { padding: 8px 14px; border: 1px solid #d8d4ca; border-radius: var(--radius-pill); background: #fff; color: inherit; font: inherit; font-size: 13px; cursor: pointer; }
  @media (max-width: 720px), (max-height: 560px) {
    .work-letter { width: min(100%, 600px); height: 90dvh; margin: auto auto 0; border-radius: var(--radius-card) var(--radius-card) 0 0; }
    .work-letter-sheet { padding: 24px 22px 0; }
    .work-letter-a, .work-letter-pledge { font-size: 19px; }
    .work-letter-waiting { font-size: 17px; }
    .work-letter-glass { --pane-w: 86px; --pane-h: 70px; --glass-pitch: 98px; height: 150px; margin: 6px -22px 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .work-letter-turn { animation: work-letter-message 300ms var(--ease-out); }
    .work-letter-think i { animation: work-letter-thinking 900ms ease-in-out infinite; }
    .work-letter-think i:nth-child(2) { animation-delay: 150ms; }
    .work-letter-think i:nth-child(3) { animation-delay: 300ms; }
    [data-work-letter-step]:not([hidden]) { animation: work-letter-message 400ms var(--ease-out); }
    .work-letter-replay { transition: opacity 400ms var(--ease-out); }
    .work-letter-company-text { transition: background-size 650ms var(--ease-out); }
    .work-letter-company.is-marked .work-letter-company-arrow { animation: work-letter-nudge 620ms var(--ease-out) 2; }
    .work-letter[open] { animation: work-letter-rise 300ms var(--ease-out); }
    .work-letter.is-closing { animation: work-letter-out 170ms ease-in forwards; }
    .work-letter[open]::backdrop { animation: work-letter-fade 240ms var(--ease-out); }
  }
  @keyframes work-letter-message { from { opacity: 0; transform: translateY(4px); } }
  @keyframes work-letter-thinking { 50% { opacity: 1; transform: translateY(-2px); } }
  @keyframes work-letter-rise { from { opacity: 0; transform: translateY(10px); } }
  @keyframes work-letter-out { to { opacity: 0; transform: translateY(6px); } }
  @keyframes work-letter-fade { from { opacity: 0; } }
  @keyframes work-letter-nudge { 45% { transform: translate(2px, -2px); } }
</style>
