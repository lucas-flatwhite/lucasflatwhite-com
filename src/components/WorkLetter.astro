---
/*
 * The letter the work badge opens: how I see insurance (src/lib/work-letter.ts plays it).
 * It carries on the badge's conversation: the visitor's doubt types into a bubble and my
 * answer streams after it, then the pledge gets its highlighter word by word, then the line
 * about meeting again waits with a blinking caret. Screen readers get the whole letter at
 * once; only the eye sees it unfold. On a phone it rises from the bottom as a sheet.
 */
import { work } from '../data/work';
import KakaoPayInsuranceMark from './KakaoPayInsuranceMark.astro';
import Glyph from './Glyph.astro';

const { letter } = work;
---

<dialog id="work-letter" class="work-letter" lang="ko" aria-labelledby="work-letter-title" data-work-letter>
  <div class="work-letter-sheet" data-work-letter-sheet>
    <button class="work-letter-close" type="button" data-work-letter-close aria-label="닫기">
      <Glyph icon="x" />
    </button>
    <p class="work-letter-eyebrow">{letter.eyebrow}</p>
    <h2 class="work-letter-title" id="work-letter-title">{letter.title}</h2>

    <div class="sr-only">
      {letter.turns.map(([question, answer]) => (
        <p>{question} {answer}</p>
      ))}
      <p>{letter.really}</p>
      <p>{letter.pledge.map(([text]) => text).join('')}</p>
      <p>{letter.waiting}</p>
    </div>

    <div class="work-letter-play" aria-hidden="true" data-work-thread>
      <div class="work-letter-thread">
        {letter.turns.map(() => (
          <div class="work-letter-turn" hidden>
            <p class="work-letter-q"></p>
            <span class="work-letter-think"><span></span><span></span><span></span></span>
            <p class="work-letter-a"></p>
          </div>
        ))}
      </div>
      <p class="work-letter-really" data-work-letter-step>{letter.really}</p>

      <p class="work-letter-pledge" data-work-letter-step>
        {letter.pledge.map(([text, marked]) => (marked ? <span class="work-letter-mark">{text}</span> : text))}
      </p>

      <p class="work-letter-waiting" data-work-letter-step>
        {letter.waiting}<span class="work-letter-caret"></span>
      </p>
    </div>

    <div class="work-letter-foot">
      <span class="work-letter-sign"><KakaoPayInsuranceMark class="work-letter-mark-logo" /><b>{letter.signature}</b></span>
      <button class="work-letter-replay" type="button" data-work-letter-replay>{letter.replay} <span aria-hidden="true">↺</span></button>
    </div>
  </div>
</dialog>

<style is:global>
  .work-letter {
    width: min(600px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 48px);
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    color: #171717;
    font-family: var(--font-ko);
  }

  .work-letter:focus {
    outline: none;
  }

  .work-letter::backdrop {
    background: rgba(23, 23, 23, 0.4);
  }

  html:has(.work-letter[open]) {
    overflow: hidden;
  }

  .work-letter-sheet {
    position: relative;
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
    padding: 44px 48px 30px;
    border-radius: 6px;
    background: #fbfaf6;
    box-shadow: 0 30px 60px rgba(23, 23, 23, 0.2), 0 2px 6px rgba(23, 23, 23, 0.08);
  }

  .work-letter-close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgba(23, 23, 23, 0.06);
    color: #171717;
    font-size: 16px;
    cursor: pointer;
  }

  .work-letter-close:hover {
    background: rgba(23, 23, 23, 0.12);
  }

  .work-letter :is(button):focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .work-letter-eyebrow {
    margin: 0;
    color: var(--blue);
    font-family: var(--font-display);
    font-size: 11px;
    font-stretch: 110%;
    font-weight: 640;
    letter-spacing: 0.16em;
  }

  .work-letter-title {
    margin: 8px 0 26px;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .work-letter-thread {
    display: grid;
    gap: 18px;
  }

  .work-letter-turn {
    display: grid;
    gap: 8px;
  }

  .work-letter-turn[hidden] {
    display: none;
  }

  .work-letter-q,
  .work-letter-a {
    margin: 0;
  }

  .work-letter-q {
    justify-self: end;
    max-width: 80%;
    padding: 9px 14px;
    border-radius: var(--radius-card);
    background: #1b1b1b;
    color: #f1f0eb;
    font-size: 14.5px;
    line-height: 1.45;
  }

  .work-letter-q:empty {
    display: none;
  }

  .work-letter-a {
    min-height: 1.3em;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.3;
    word-break: keep-all;
  }

  .work-letter-think {
    display: none;
    gap: 6px;
    align-items: center;
    height: 1.3em;
    font-size: 22px;
  }

  .work-letter-turn.is-thinking .work-letter-think {
    display: flex;
  }

  .work-letter-turn.is-thinking .work-letter-a {
    display: none;
  }

  .work-letter-think span {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: #1b1b1b;
  }

  .work-letter-caret {
    display: inline-block;
    width: 0.42em;
    height: 0.85em;
    margin-left: 0.08em;
    background: #1b1b1b;
    vertical-align: -0.05em;
  }

  .work-letter-q .work-letter-caret {
    width: 2px;
    height: 1em;
    background: #f1f0eb;
    vertical-align: -0.15em;
  }

  .work-letter-really {
    margin: 6px 0 0;
    color: #77736a;
    font-size: 15px;
  }

  .work-letter-pledge,
  .work-letter-waiting {
    margin: 30px 0 0;
    padding-top: 24px;
    border-top: 1px dotted #c9c5bb;
  }

  .work-letter-pledge {
    position: relative;
    isolation: isolate;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.6;
    word-break: keep-all;
  }

  .work-letter-mark {
    position: relative;
    padding: 0 2px;
  }

  .work-letter-mark::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.12em;
    left: 0;
    z-index: -1;
    height: 0.48em;
    background: #ffeb00;
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .work-letter-mark.is-marked::before {
    transform: scaleX(1);
  }

  .work-letter-waiting {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  .work-letter-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 26px;
  }

  .work-letter-sign {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #3a3833;
    font-size: 13px;
  }

  .work-letter-sign b {
    font-weight: 600;
  }

  .work-letter-mark-logo {
    width: 112px;
    color: #231815;
    line-height: 0;
  }

  .work-letter-mark-logo svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .work-letter-replay {
    padding: 8px 14px;
    border: 1px solid #d8d4ca;
    border-radius: var(--radius-pill);
    background: #fff;
    color: inherit;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  /* While it plays, the steps after the current one wait out of sight. */
  .work-letter.is-playing [data-work-letter-step]:not(.is-on),
  .work-letter.is-playing .work-letter-replay:not(.is-on) {
    opacity: 0;
    pointer-events: none;
  }

  /* A phone, or a screen too short for the sheet: the letter rises from the bottom. */
  @media (max-width: 720px), (max-height: 560px) {
    .work-letter {
      width: min(100%, 600px);
      max-height: 90dvh;
      margin: auto auto 0;
    }

    .work-letter-sheet {
      max-height: 90dvh;
      padding: 32px 22px max(24px, env(safe-area-inset-bottom));
      border-radius: var(--radius-card) var(--radius-card) 0 0;
    }

    .work-letter-a,
    .work-letter-pledge {
      font-size: 19px;
    }

    .work-letter-waiting {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-letter[open] .work-letter-sheet {
      animation: work-letter-rise 420ms var(--ease-out);
    }

    .work-letter.is-closing {
      animation: work-letter-out 170ms ease-in forwards;
    }

    .work-letter[open]::backdrop {
      animation: work-letter-fade 240ms var(--ease-out);
    }

    .work-letter-think span {
      animation: work-letter-think 1s ease-in-out infinite;
    }

    .work-letter-think span:nth-child(2) {
      animation-delay: 0.15s;
    }

    .work-letter-think span:nth-child(3) {
      animation-delay: 0.3s;
    }

    .work-letter-waiting .work-letter-caret {
      animation: work-letter-caret 1.1s steps(1, end) infinite;
    }

    [data-work-letter-step],
    .work-letter-replay {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }

    .work-letter.is-playing [data-work-letter-step]:not(.is-on) {
      transform: translateY(4px);
    }

    .work-letter-mark::before {
      transition: transform 520ms var(--ease-out);
    }

    @media (max-width: 720px), (max-height: 560px) {
      .work-letter[open] .work-letter-sheet {
        animation: work-letter-up 520ms var(--ease-out);
      }
    }
  }

  @keyframes work-letter-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes work-letter-up {
    from {
      transform: translateY(100%);
    }
  }

  @keyframes work-letter-out {
    to {
      opacity: 0;
      transform: translateY(6px) scale(0.985);
    }
  }

  @keyframes work-letter-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes work-letter-think {
    0%,
    80%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }

    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  @keyframes work-letter-caret {
    50% {
      opacity: 0;
    }
  }
</style>
