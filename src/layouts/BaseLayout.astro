---
import '@fontsource-variable/anybody/wdth.css';
import '@fontsource-variable/noto-sans-kr';
import '../styles/global.css';
import { withBase } from '../lib/paths';

type Props = {
  title: string;
  description: string;
  bodyClass?: string;
};

const { title, description, bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f35b5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@lucas_flatwhite" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
