---
import '@fontsource-variable/anybody/wdth.css';
import '@fontsource-variable/noto-sans-kr';
import '../styles/global.css';
import { withBase } from '../lib/paths';

type Props = {
  title: string;
  description: string;
  bodyClass?: string;
  themeColor?: string;
  /** The address search engines and shares should use, when it is not this page's own. */
  canonicalPath?: string;
  /** Keeps the page out of search (/hi/, which only a QR leads to). */
  noindex?: boolean;
};

const { title, description, bodyClass, themeColor = '#171717', canonicalPath = Astro.url.pathname, noindex = false } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
// The X profile picture, so a shared link carries the same face as the account.
const shareImage = new URL(withBase('og-image.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="A cat drawn in black line on a yellow field." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@lucas_flatwhite" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content="A cat drawn in black line on a yellow field." />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
