{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/commands.json", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ],
  "redirects": [
    { "source": "/ai-timeline-log/en/", "destination": "/ai-timeline-log/", "permanent": true },
    { "source": "/arcade", "destination": "/arcade/", "permanent": true },
    { "source": "/arcade/suika", "destination": "/arcade/suika/", "permanent": true },
    { "source": "/ai-timeline-log/en", "destination": "/ai-timeline-log/", "permanent": true },
    { "source": "/ai-timeline-log/en/:path*", "destination": "/ai-timeline-log/:path*", "permanent": true },
    { "source": "/ai-timeline-log", "destination": "/ai-timeline-log/", "permanent": true },
    { "source": "/ai-timeline-log/ko", "destination": "/ai-timeline-log/ko/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/ai-timeline-log/", "destination": "https://ai-timeline-log.vercel.app/ai-timeline-log/index.html" },
    { "source": "/ai-timeline-log/:path*/", "destination": "https://ai-timeline-log.vercel.app/ai-timeline-log/:path*/index.html" },
    { "source": "/ai-timeline-log/:path*", "destination": "https://ai-timeline-log.vercel.app/ai-timeline-log/:path*" },
    { "source": "/arcade/", "destination": "https://flatwhite-arcade.vercel.app/arcade/index.html" },
    { "source": "/arcade/suika/", "destination": "https://suika-balls.vercel.app/index.html" },
    { "source": "/arcade/suika/:path*", "destination": "https://suika-balls.vercel.app/:path*" },
    { "source": "/arcade/:path*/", "destination": "https://flatwhite-arcade.vercel.app/arcade/:path*/index.html" },
    { "source": "/arcade/:path*", "destination": "https://flatwhite-arcade.vercel.app/arcade/:path*" }
  ]
}
